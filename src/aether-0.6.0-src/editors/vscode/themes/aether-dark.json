{
  "name": "Aether Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1f1f1f", "editor.foreground": "#d4d4d4", "editorLineNumber.foreground": "#6e7681", "editorLineNumber.activeForeground": "#cccccc",
    "editor.lineHighlightBackground": "#282828", "editorCursor.foreground": "#aeafad", "editor.selectionBackground": "#3a3d6b",
    "activityBar.background": "#181818", "activityBar.foreground": "#ffffff", "activityBar.inactiveForeground": "#868686", "activityBar.activeBorder": "#8b7ff7", "activityBarBadge.background": "#6d5ef5",
    "sideBar.background": "#181818", "sideBar.border": "#2b2b2b", "sideBarSectionHeader.background": "#181818", "sideBarTitle.foreground": "#9d9d9d",
    "titleBar.activeBackground": "#181818", "titleBar.border": "#2b2b2b", "commandCenter.background": "#2a2a2a",
    "tab.activeBackground": "#1f1f1f", "tab.inactiveBackground": "#181818", "tab.activeBorderTop": "#8b7ff7", "tab.border": "#2b2b2b", "editorGroupHeader.tabsBackground": "#181818",
    "panel.background": "#181818", "panel.border": "#2b2b2b", "panelTitle.activeBorder": "#8b7ff7",
    "statusBar.background": "#6d5ef5", "statusBar.foreground": "#ffffff", "statusBar.noFolderBackground": "#6d5ef5", "statusBar.debuggingBackground": "#c24e00",
    "button.background": "#6d5ef5", "button.hoverBackground": "#8b7ff7", "focusBorder": "#8b7ff7", "progressBar.background": "#8b7ff7",
    "input.background": "#313131", "dropdown.background": "#313131", "quickInput.background": "#252526", "editorWidget.background": "#252526",
    "list.activeSelectionBackground": "#04395e", "list.hoverBackground": "#2a2d2e", "badge.background": "#6d5ef5",
    "editorError.foreground": "#f14c4c", "editorWarning.foreground": "#cca700", "editorInfo.foreground": "#3794ff",
    "terminal.background": "#181818", "terminal.ansiGreen": "#73c991"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#6a9955" } },
    { "scope": ["string", "meta.interpolation punctuation"], "settings": { "foreground": "#ce9178" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#b5cea8" } },
    { "scope": ["keyword", "storage.type", "keyword.declaration"], "settings": { "foreground": "#c586c0" } },
    { "scope": ["keyword.other.contract"], "settings": { "foreground": "#c586c0", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#d4d4d4" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#4ec9b0" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#dcdcaa" } },
    { "scope": ["variable"], "settings": { "foreground": "#9cdcfe" } }
  ],
  "semanticTokenColors": {
    "namespace": "#4ec9b0", "class": "#4ec9b0", "type": "#4ec9b0", "enum": "#4ec9b0", "enumMember": "#4fc1ff",
    "function": "#dcdcaa", "method": "#dcdcaa", "event": "#dcdcaa", "variable": "#9cdcfe", "parameter": "#9cdcfe",
    "property": "#9cdcfe", "keyword": "#c586c0", "string": "#ce9178", "number": "#b5cea8", "comment": "#6a9955", "operator": "#d4d4d4",
    "*.defaultLibrary": { "foreground": "#dcdcaa", "italic": true }
  }
}
