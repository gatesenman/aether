let a = 7
let b = 2
print(a + b, a - b, a * b, a / b, a % b, -a % 3, 7.5 / 2.5, 10 / 4)
print(1 + 2.0, 0.1 + 0.2, 2 * 3.5, 1.0 / 3)
print("x" + 1, 1 + "x", "n=" + 2.5, "a" * 3)
print(1 == 1.0, "a" < "b", [1, 2] == [1, 2], not true, nil == nil)
print(true and false, nil or "dflt", 0 or 5, "" or "e")
var i = 0
let xs = [3, 1, 2]
while i < 3 { i += 1 }
print("i={i} n={1 + 2} {len(xs)}")

print(xs[0], xs[-1], len(xs), xs.len(), sort(xs), reverse(xs), sum(xs), max(xs), min(4, 9))
let r = {name: "Ada", tags: ["x", "y"], n: 1.5}
print(r, r.name, r.tags[1], keys(r), values(r))
print(range(3), range(2, 5), map(range(4), fn(x) => x * x), filter([1, 2, 3, 4], fn(x) => x % 2 == 0))
print(reduce([1, 2, 3], fn(acc, x) => acc + x, 10), join(["a", "b"], "-"), split("a,b", ","), upper("ab"), lower("CD"))
print(contains([1, 2], 2), contains("hello", "ell"), str(12), int("42"), float(3), abs(-3), floor(2.7), round(2.567, 2), sqrt(16))
print(json({a: [1, "x", true, nil]}), parse_json("[1, 2.5]"), type_of(1), type_of("s"), type_of([]))
for ch in "ab" { print(ch) }
for kv in {k: 1} { print(kv.key, kv.value) }
print(sort(["b", "a", "c"]), sort([{n: 2}, {n: 1}], fn(x) => x.n))
