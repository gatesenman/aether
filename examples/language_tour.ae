// 语言特性巡礼：类型、泛型、闭包、代数数据类型、模式匹配、管道、效果、异常、并发
module tour

type Shape = Circle(r: Float) | Rect(w: Float, h: Float) | Dot

fn area(s: Shape) -> Float {
  match s {
    Circle(r) => 3.14159 * r * r,
    Rect(w, h) => w * h,
    Dot => 0.0
  }
}

fn identity<T>(x: T) -> T { x }

fn make_counter() -> fn {
  var n = 0
  fn() { n += 1; n }
}

fn fib(n: Int) -> Int {
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn safe_div(a: Int, b: Int) -> Int {
  if b == 0 { throw "除数不能为 0" }
  a / b
}

fn classify(n: Int) -> Text {
  match n {
    0 => "零",
    x if x < 0 => "负数",
    x if x % 2 == 0 => "偶数",
    _ => "奇数"
  }
}

let shapes = [Circle(1.0), Rect(2.0, 3.0), Dot]
print("面积:", shapes |> map(area))
print("泛型:", identity("hello"), identity(42))

let c = make_counter()
c(); c()
print("闭包计数:", c())

print("管道:", range(10) |> filter(fn(x) => x % 2 == 0) |> map(fn(x) => x * x) |> sum)
print("分类:", map([0, -3, 4, 7], classify))

try { safe_div(1, 0) } catch e { print("捕获异常:", e) }

let jobs = map([20, 21, 22], fn(n) => spawn fib(n))
print("并发结果:", await jobs)

let user = {name: "Ada", langs: ["Aether", "Python"]}
print("记录: {user.name} 会 {len(user.langs)} 门语言")
